# ==============================================================
# SkyRoute Backend - Production & Development Environment Config
# ==============================================================

# Server Port (Render automatically sets PORT in production)
PORT=5000
NODE_ENV=production

# MongoDB Atlas or Local Database Connection String
# Supports either MONGODB_URI or MONGO_URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/skyroute?retryWrites=true&w=majority

# JWT Authentication Secret and Expiration
JWT_SECRET=your_super_secret_production_jwt_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origins for CORS and Socket.IO
# Comma-separated list of origins (e.g., your Vercel frontend URL, custom domain, and localhost)
CLIENT_URL=https://skyroute.vercel.app,http://localhost:5173

# Optional alias for single origin:
# CLIENT_ORIGIN=https://skyroute.vercel.app
