# ===============================================================
# SkyRoute Frontend - Production & Development Environment Config
# ===============================================================

# Backend API server URL (Render deployed backend)
# In production on Vercel, set to: https://skyroute-backend-6lxo.onrender.com
# Can be configured with or without trailing '/api'
VITE_API_URL=https://skyroute-backend-6lxo.onrender.com

# Backend Socket.IO server URL (Render deployed backend)
# In production on Vercel, set to: https://skyroute-backend-6lxo.onrender.com
VITE_SOCKET_URL=https://skyroute-backend-6lxo.onrender.com

