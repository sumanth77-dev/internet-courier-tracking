PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/courier_tracking_db

# JWT Authentication
JWT_SECRET=your_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Optional Development Account Seed Overrides (do not commit real passwords)
# ADMIN_SEED_EMAIL=admin@couriertrack.com
# ADMIN_SEED_PASSWORD=your_admin_dev_password
# COURIER_SEED_EMAIL=courier@couriertrack.com
# COURIER_SEED_PASSWORD=your_courier_dev_password